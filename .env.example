# ==============================================================================
# CURIORA AI KNOWLEDGE ORCHESTRATOR — GATEWAY & MODEL CONFIGURATION
# ==============================================================================
# Pilihan AI_PROVIDER: "auto" | "openrouter" | "sumopod" | "gemini"
# Jika "auto", sistem otomatis mendeteksi API Key yang terisi (OpenRouter -> SumoPod -> Gemini -> Deterministic Fallback).
AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# OPSI 1 (UTAMA - 100% GRATIS TANPA KARTU KREDIT): OPENROUTER + NVIDIA NEMOTRON 3 ULTRA
# ------------------------------------------------------------------------------
# Cara ambil API Key gratis (30 detik, tanpa kartu kredit):
# 1. Buka https://openrouter.ai/settings/keys -> Login pakai akun Google/GitHub
# 2. Klik "Create Key" -> Salin key (sk-or-v1-...) ke OPENROUTER_API_KEY di bawah
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Penalaran Utama: NVIDIA: Nemotron 3 Ultra (free)
# Catatan Arsitektur: Karena Nemotron 3 Ultra berbasis penalaran Bahasa Inggris,
# Curiora AI Orchestrator otomatis menjalankan pipeline Bilingual Pivot:
# Input ID -> Pivot EN (Stage 2C) -> Nemotron 3 Ultra Reasoning (Stage 3A) -> Adaptasi EN ke ID (Stage 3B).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Model Jembatan Translasi & Akselerator Bilingual (Gratis di OpenRouter untuk lokalisasi EN <-> ID)
OPENROUTER_TRANSLATOR_MODEL=nvidia/nemotron-3.5-lightning:free

# ------------------------------------------------------------------------------
# OPSI 2 (ALTERNATIF CEPAT & NATIVE INDONESIA): SUMOPOD AI GATEWAY
# ------------------------------------------------------------------------------
# Jika ingin beralih ke SumoPod (lebih cepat tanpa antrean tier gratis OpenRouter):
# 1. Buka https://sumopod.com -> Dashboard -> API Keys -> Buat API Key baru (sk-...)
# 2. Tempel ke SUMOPOD_API_KEY di bawah (dan bisa ubah AI_PROVIDER=sumopod)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPSI 3 (CADANGAN): GOOGLE AI STUDIO (GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
