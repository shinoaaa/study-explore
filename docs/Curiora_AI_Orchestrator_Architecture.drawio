        <!-- SWIMLANE 2: AI KNOWLEDGE ORCHESTRATOR -->
        <mxCell id="lane_orch" value="2. CURIORA 5-STAGE AI KNOWLEDGE ORCHESTRATOR (/api/orchestrate &amp; src/lib/ai-orchestrator.ts)" style="swimlane;startSize=34;fillColor=#EFF6FF;strokeColor=#2F80ED;fontColor=#1E3A8A;fontStyle=1;fontSize=13;rounded=1;arcSize=6;" vertex="1" parent="1">
