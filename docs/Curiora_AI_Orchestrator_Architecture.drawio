        <mxCell id="title_box" value="ARSITEKTUR CURIORA 5-STAGE AI KNOWLEDGE ORCHESTRATOR&#xa;Structured Input Envelope → Intent Router → Cross-Node Relation Analyzer → DAG &amp; Organic Layout Guard → Non-Destructive Output Envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17263C;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
