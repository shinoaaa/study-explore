        <mxCell id="stage1" value="STAGE 1: Input Context Assembler (OrchestratorInputEnvelope)&#xa;• Packages VaultIdentity + Target Node Action (instant_ai | custom_prompt | user_note | book_chapter)&#xa;• Builds Compact Existing Graph Snapshot: All existing Nodes [id, title, region, summary] &amp; Edges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F80ED;strokeWidth=2;fontColor=#17233C;fontStyle=1;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="lane_orch">
          <mxGeometry x="35" y="55" width="690" height="95" as="geometry" />
        </mxCell>

        <mxCell id="stage2a" value="STAGE 2A: Intent Router &amp; Schema Compiler&#xa;• Routes: SEED_FIRST_NODE | OPEN_NODE | BRANCH_NEW_NODE&#xa;• Compiles Strict JSON Schema Contract&#xa;• Enforces Zero Internal Code Leak Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#17233C;fontStyle=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="lane_orch">
          <mxGeometry x="35" y="185" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="stage2b" value="STAGE 2B: Cross-Node Relationship Analyzer&#xa;• Scans ALL existing nodes in Vault when a node opens&#xa;• Detects semantic &amp; cross-region links across branches&#xa;• Generates OrchestratorCrossLink[] + Edge Reasons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontStyle=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="lane_orch">
          <mxGeometry x="395" y="185" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="stage3" value="STAGE 3: Structured Synthesis &amp; Frontier Spawner&#xa;• Synthesizes Primary Node: 3-Level Explanations (Simple/Standard/Deep), Formula, Application, QuickCheck&#xa;• Spawns 2–3 Progressive Frontier Nodes in Fog of War (explored: false) for step-by-step exploration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9468;strokeWidth=2;fontColor=#065F46;fontStyle=1;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="lane_orch">
          <mxGeometry x="35" y="340" width="690" height="105" as="geometry" />
        </mxCell>

        <mxCell id="stage4" value="STAGE 4: DAG Validator, Anti-Orphan Guard &amp; Organic Staggered Layout Engine (validator.ts)&#xa;• Verifies Acyclic Prerequisite DAG &amp; Valid 6-Region Classification&#xa;• Computes Dynamic Organic Node Coordinates (Staggered X/Y Wave + Region Aura Containment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontStyle=1;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="lane_orch">
          <mxGeometry x="35" y="480" width="690" height="105" as="geometry" />
        </mxCell>

        <mxCell id="stage5" value="STAGE 5: Non-Destructive Vault Reconciler &amp; Output Envelope (OrchestratorOutputEnvelope)&#xa;• Preserves User-Edited Notes &amp; Attaches Node Chapter/Prompt/Note Metadata&#xa;• Emits Trace Telemetry (openedNodeId, spawnedFrontierNodeIds, crossLinksDiscovered, dagValid) + Normalized Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#172554;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="lane_orch">
